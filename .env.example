# Get a key at https://platform.tripo3d.ai (Console -> API Keys)
TRIPO_API_KEY=
# Set to 1 to exercise the full pipeline without spending credits
TRIPO_DRY_RUN=0
PORT=5173
# Shared hero gallery (Supabase). Run supabase/schema.sql once, then copy these from
# Project Settings -> API Keys: the secret key (sb_secret_...) or legacy service_role key.
# It is server-only: never ship it to the browser. The publishable key is not used.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
